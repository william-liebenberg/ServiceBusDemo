@page "/"
@using ServiceBusDemo.ServiceDefaults
@implements IDisposable

@inject ProducerApiClient ProducerApi
@inject DeliveryFeed Feed
@inject ILogger<Home> Logger
@inject IServiceProvider Services

@{
    var snapshot = Feed.Snapshot(out var reportCount, out var clearCount);
    // Retained reports are a contiguous suffix of the insertion sequence, even after a clear.
    var firstSequence = reportCount - snapshot.Count + 1;
    var deliveriesByConsumer = snapshot.Select((delivery, index) => new DeliveryCard(firstSequence + index, delivery))
        .ToLookup(card => card.Delivery.Consumer);
    var visibleCards = consumers.SelectMany(consumer => deliveriesByConsumer[consumer.Id]).ToArray();
    var cardsByMessage = visibleCards.ToLookup(card => card.Delivery.MessageId);
    var hover = hoveredCard?.Card.Sequence >= firstSequence ? hoveredCard : null;
    var focus = focusedCard?.Card.Sequence >= firstSequence ? focusedCard : null;
    // Correlate only the most recent interaction that is still active and visible.
    var active = focus is null || hover?.Order > focus.Order ? hover : focus;
    var highlightedId = active?.Card.Delivery.MessageId;
    UpdateDeliveryStatus(visibleCards, reportCount, clearCount);
}

<PageTitle>Service Bus Demo</PageTitle>

@if (burstDelay is not null || deadLetterActing)
{
    <NavigationLock ConfirmExternalNavigation="true" OnBeforeInternalNavigation="ConfirmHomeNavigationAsync" />
}
@if (deadLetterActing)
{
    <p id="dead-letter-navigation-warning" class="text-warning-emphasis" role="status">@DeadLetterNavigationWarning</p>
}

<h1>Service Bus Demo</h1>

<div class="nav nav-tabs mb-3" role="tablist" aria-label="Service Bus demo views" @onkeydown="NavigateHomeTabsAsync">
    <button type="button" class="nav-link @(!DeadLetterActive ? "active" : TabSwitchBlocked ? "disabled" : null)" id="messaging-tab" role="tab"
            aria-controls="messaging-panel" aria-selected="@(!DeadLetterActive ? "true" : "false")"
            aria-disabled="@(DeadLetterActive && TabSwitchBlocked ? "true" : null)"
            tabindex="@(!DeadLetterActive ? 0 : -1)" @ref="messagingTab" @onclick="SwitchToMessaging">Messaging</button>
    <button type="button" class="nav-link @(DeadLetterActive ? "active" : TabSwitchBlocked ? "disabled" : null)" id="dead-letter-tab" role="tab"
            aria-controls="dead-letter-panel" aria-selected="@(DeadLetterActive ? "true" : "false")"
            aria-disabled="@(!DeadLetterActive && TabSwitchBlocked ? "true" : null)"
            tabindex="@(DeadLetterActive ? 0 : -1)" @ref="deadLetterTab" @onclick="OpenDeadLettersAsync">Dead-letter</button>
</div>
<div id="home-tab-status" class="@(TabSwitchBlocked ? "text-body-secondary mb-3" : null)" role="status" aria-atomic="true">@(
    deadLetterActing ? "Switch tabs after the dead-letter action finishes." :
    isSending ? "Switch tabs after the send finishes." :
    burstDelay is not null ? "Switch tabs after the burst finishes or is cancelled." : null)</div>

<section id="dead-letter-panel" role="tabpanel" aria-labelledby="dead-letter-tab" tabindex="0" hidden="@(!DeadLetterActive)">
    @if (DeadLetterActive)
    {
        <h2 class="h5">Dead-letter messages</h2>
        <p id="dead-letter-help">Viewing only peeks at a page of messages, not a broker count. The current page refreshes every two seconds. Next page may be empty.</p>
        <p>Resubmit removes the <code>always-fail</code> property and publishes to the original topic. Other matching subscriptions can receive a copy,
            and retained <code>fail-first-count</code> or other properties can cause another failure. A successful publish does not prove processing,
            and a missing delivery report does not prove that processing failed. Purge removes only the selected original without republishing.</p>
        <p>Actions can temporarily lock other dead letters and affect their delivery counts. If you lost the result or the outcome is uncertain, @DeadLetterRecoveryGuidance</p>
        <div class="d-flex flex-wrap align-items-end gap-2 mb-2">
            <div>
                <label for="dead-letter-subscription" class="form-label">Topic / subscription</label>
                <select id="dead-letter-subscription" class="form-select" value="@Array.IndexOf(deadLetterSubscriptions, deadLetterSelection)"
                        disabled="@(deadLetterActing || deadLetterSubscriptions.Length == 0)" @onchange="SelectDeadLetterSubscriptionAsync">
                    @for (var index = 0; index < deadLetterSubscriptions.Length; index++)
                    {
                        var pair = deadLetterSubscriptions[index];
                        <option value="@index">@pair.Topic / @pair.Subscription</option>
                    }
                </select>
            </div>
            <button id="dead-letter-refresh" type="button" class="btn btn-outline-secondary" disabled="@deadLetterActing"
                    @onclick="RefreshDeadLettersAsync">Refresh</button>
        </div>
        <div id="dead-letter-load-error" role="alert" class="text-danger-emphasis">@deadLetterLoadError</div>
        <div tabindex="-1" @ref="deadLetterResult" role="group" aria-label="Dead-letter results">
        <div id="dead-letter-action-error" role="alert" class="text-danger-emphasis">@deadLetterActionError</div>
        <div id="dead-letter-status" role="status" aria-atomic="true">
            @if (deadLetterActionStatus is not null) { <p class="mb-1">@deadLetterActionStatus</p> }
            @if (deadLetterPage is null && deadLetterLoading) { <p>Loading dead letters…</p> }
            else if (deadLetterLoadError is null && deadLetterPage?.Messages.Length == 0) { <p>No dead letters on this page.</p> }
            else if (deadLetterLoadError is null && !deadLetterLoading && deadLetterSelection is null) { <p>No subscriptions configured.</p> }
        </div>
        </div>
        @if (deadLetterPage is { } page && deadLetterSelection is { } selection)
        {
            @foreach (var message in page.Messages)
            {
                <article class="dead-letter-card mb-2" @key="(selection, message.SequenceNumber)" aria-labelledby="@($"dead-letter-{message.SequenceNumber}")"
                         @onfocusin="() => focusedDeadLetter = (selection, message.SequenceNumber)"
                         @onfocusout="() => DeadLetterBlurred(selection, message.SequenceNumber)">
                    <h3 class="h6" id="@($"dead-letter-{message.SequenceNumber}")">Sequence @message.SequenceNumber</h3>
                    <dl class="mb-2">
                        <dt>Message ID</dt><dd><code>@message.MessageId</code></dd>
                        <dt>Dead-letter reason</dt><dd>@(message.DeadLetterReason ?? "Not provided")</dd>
                        <dt>Error description</dt><dd>@(message.DeadLetterErrorDescription ?? "Not provided")</dd>
                        <dt>Delivery count</dt><dd>@message.DeliveryCount</dd>
                        <dt>Body</dt><dd class="dead-letter-body">@message.Body</dd>
                        <dt>Application properties</dt>
                        <dd>
                            @if (message.ApplicationProperties.Count == 0) { <span>None</span> }
                            else
                            {
                                <dl class="mb-0">
                                    @foreach (var (key, value) in message.ApplicationProperties)
                                    {
                                        <dt>@key</dt><dd>@value</dd>
                                    }
                                </dl>
                            }
                        </dd>
                    </dl>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-outline-primary" disabled="@deadLetterActing" aria-label="Resubmit sequence @message.SequenceNumber"
                                @onclick="() => ActOnDeadLetterAsync(selection, message.SequenceNumber, true)">Resubmit</button>
                        <button type="button" class="btn btn-outline-danger" disabled="@deadLetterActing" aria-label="Purge sequence @message.SequenceNumber"
                                @onclick="() => BeginPurge(selection, message.SequenceNumber)">Purge</button>
                    </div>
                    @if (pendingPurge == (selection, message.SequenceNumber))
                    {
                        <fieldset class="mt-2" id="dead-letter-purge-confirmation">
                            <legend class="h6">Permanently purge sequence @message.SequenceNumber from @selection.Topic / @selection.Subscription?</legend>
                            <p id="dead-letter-purge-note">This cannot be undone. No copy will be published.</p>
                            <button type="button" class="btn btn-outline-secondary" @ref="purgeCancel" @onclick="CancelPurge">Cancel</button>
                            <button type="button" class="btn btn-danger" aria-describedby="dead-letter-purge-note" @onclick="ConfirmPurgeAsync">Confirm purge</button>
                        </fieldset>
                    }
                </article>
            }
        }
        <nav class="d-flex flex-wrap gap-2" aria-label="Dead-letter pages">
            <button id="dead-letter-previous" type="button" class="btn btn-outline-secondary" disabled="@(deadLetterActing || deadLetterHistory.Count == 0)"
                    @onclick="() => MoveDeadLetterPageAsync(false)">Previous page</button>
            <button id="dead-letter-next" type="button" class="btn btn-outline-secondary" disabled="@(deadLetterActing || deadLetterPage?.NextFromSequenceNumber is null)"
                    @onclick="() => MoveDeadLetterPageAsync(true)">Next page</button>
        </nav>
    }
</section>

<div id="messaging-panel" role="tabpanel" aria-labelledby="messaging-tab" hidden="@DeadLetterActive">
<p>Publish a message to Azure Service Bus via the producer API, choosing which messaging pattern to demonstrate.</p>

@* Let Blazor show the same accessible option errors for single and burst sends. *@
<EditForm EditContext="messageContext" OnValidSubmit="SendAsync" FormName="send-message" novalidate>
    <DataAnnotationsValidator />
    <fieldset class="mb-3" disabled="@Busy">
        <legend class="form-label fs-6">Pattern</legend>
        <InputRadioGroup @bind-Value="model.Pattern" @bind-Value:after="RevalidateMetadata">
            <div class="form-check">
                <InputRadio id="pattern-competing" class="form-check-input" Value="MessagingPattern.CompetingConsumers" />
                <label class="form-check-label" for="pattern-competing">
                    <strong>Competing consumers</strong> &ndash; <code>business-events</code> topic, one shared subscription.
                    Each delivery attempt is handled by <em>one</em> consumer, but redeliveries may reach either lane.
                </label>
            </div>
            <div class="form-check">
                <InputRadio id="pattern-pubsub" class="form-check-input" Value="MessagingPattern.PubSub" />
                <label class="form-check-label" for="pattern-pubsub">
                    <strong>Publish/subscribe</strong> &ndash; <code>broadcast-events</code> topic, one subscription per consumer.
                    Each message is handled by <em>every</em> consumer.
                </label>
            </div>
            <div class="form-check">
                <InputRadio id="pattern-topic-filters" class="form-check-input" Value="MessagingPattern.TopicFilters" />
                <label class="form-check-label" for="pattern-topic-filters">
                    <strong>Topic filters</strong> &ndash; <code>routed-events</code> topic, with rules evaluated independently by the broker.
                </label>
            </div>
        </InputRadioGroup>
    </fieldset>

    @if (IsTopicFilters)
    {
        <fieldset class="mb-3" disabled="@Busy">
            <legend class="form-label fs-6">Routing properties</legend>
            <div class="row g-2 mb-3">
                <div class="col-sm">
                    <label for="route-priority" class="form-label">Priority (optional)</label>
                    <InputText id="route-priority" class="form-control" @bind-Value="model.Priority" placeholder="High" />
                </div>
                <div class="col-sm">
                    <label for="route-region" class="form-label">Region (optional)</label>
                    <InputText id="route-region" class="form-control" @bind-Value="model.Region" placeholder="EU" />
                </div>
            </div>
        </fieldset>
        <div class="table-responsive" role="region" tabindex="0" aria-labelledby="routing-rules-caption">
            <table id="routing-rules" class="table table-sm caption-top">
                <caption id="routing-rules-caption">Routed subscription rules</caption>
                <thead><tr><th scope="col">Subscription</th><th scope="col">Rule</th><th scope="col">Consumer</th></tr></thead>
                <tbody>
                    <tr><th scope="row"><code>high-priority</code></th><td><code>Priority = 'High'</code></td><td>Consumer One</td></tr>
                    <tr><th scope="row"><code>eu-orders</code></th><td><code>Region = 'EU'</code></td><td>Consumer Two</td></tr>
                    <tr><th scope="row"><code>all</code></th><td>Unfiltered (all messages)</td><td>Consumer One</td></tr>
                </tbody>
            </table>
        </div>
    }

    <div class="mb-3">
        <label for="message" class="form-label">Message</label>
        <InputTextArea id="message" class="form-control" rows="4" @bind-Value="model.Message" @ref="messageInput"
                       placeholder="Enter a business event message..." disabled="@Busy" aria-describedby="message-error" />
        <div id="message-error" class="message-validation">
            <ValidationMessage For="() => model.Message" />
        </div>
    </div>

    <fieldset class="mb-3" disabled="@Busy" aria-describedby="failure-lab-help">
        <legend class="form-label fs-6">Failure lab</legend>
        <p id="failure-lab-help" class="text-body-secondary">
            Applies to single and burst sends. Poison overrides fail-first; the delay applies to every attempt.
            The application dead-letters intentional failures on attempt @FailureLab.AttemptLimit or later.
            @(EmulatorMaxDeliveryCount is int brokerLimit
                ? $"The local emulator is configured with a broker limit of {brokerLimit}."
                : "The broker limit is not specified here; its default or external configuration applies.")
            External brokers must allow at least @FailureLab.AttemptLimit deliveries to see explicit dead-lettering.
            Redelivery can repeat work: at-least-once handlers must be idempotent.
        </p>
        <div class="form-check">
            <input id="fail-first" type="checkbox" class="form-check-input" @bind="failFirst" @bind:after="RevalidateFailFirst" />
            <label for="fail-first" class="form-check-label">Fail first N attempts</label>
        </div>
        @if (failFirst)
        {
            <label for="fail-first-count" class="form-label">Failure count (1–10)</label>
            <input id="fail-first-count" type="number" min="1" max="10" step="1" class="form-control" @ref="failFirstCountInput"
                   @bind="failFirstCount" @bind:event="oninput" @bind:after="RevalidateFailFirst"
                   aria-invalid="@(failFirstError is not null ? "true" : "false")" aria-describedby="fail-first-error" />
            <div id="fail-first-error" class="text-danger-emphasis" aria-live="polite">@failFirstError</div>
        }
        <div class="form-check">
            <input id="always-fail" type="checkbox" class="form-check-input" @bind="alwaysFail" />
            <label for="always-fail" class="form-check-label">Poison message (always fail)</label>
        </div>
        <div class="form-check">
            <input id="slow-handler" type="checkbox" class="form-check-input" @bind="slowHandler" @bind:after="RevalidateDelay" />
            <label for="slow-handler" class="form-check-label">Slow handler</label>
        </div>
        @if (slowHandler)
        {
            <label for="delay-seconds" class="form-label">Delay in seconds (1–120)</label>
            <input id="delay-seconds" type="number" min="1" max="120" step="1" class="form-control" @ref="delaySecondsInput"
                   @bind="delaySeconds" @bind:event="oninput" @bind:after="RevalidateDelay"
                   aria-invalid="@(delaySecondsError is not null ? "true" : "false")" aria-describedby="delay-seconds-error" />
            <div id="delay-seconds-error" class="text-danger-emphasis" aria-live="polite">@delaySecondsError</div>
        }
    </fieldset>

    <details class="mb-3" open="@advancedOpen">
        <summary id="advanced-heading" @onclick="() => advancedOpen = !advancedOpen" @onclick:preventDefault>Advanced</summary>
        <div id="advanced-errors" class="text-danger-emphasis" role="alert" aria-atomic="true" tabindex="-1" @ref="advancedErrorSummary">
            @if (metadataErrors.Count > 0)
            {
                <p class="mb-1">Check the Advanced settings before sending:</p>
                <ul>
                    @foreach (var error in metadataErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            }
        </div>
        <fieldset class="my-2" disabled="@Busy" aria-labelledby="advanced-heading" aria-describedby="advanced-errors">
            @if (IsTopicFilters)
            {
                <p class="text-body-secondary">Optional subject and custom metadata. Set <code>Priority</code> and <code>Region</code> only in Routing properties; the rules use those exact names.</p>
            }
            else
            {
                <p class="text-body-secondary">Optional metadata for single sends and bursts.</p>
            }
            <div class="metadata-fields mb-2">
                <div>
                    <label class="form-label" for="advanced-subject">Subject</label>
                    <input class="form-control" id="advanced-subject" @bind="subject" @bind:event="oninput" @bind:after="RevalidateMetadata" />
                </div>
                @if (!IsTopicFilters)
                {
                    <div>
                        <label class="form-label" for="advanced-priority">Priority</label>
                        <select class="form-select" id="advanced-priority" @bind="priority" @bind:after="RevalidateMetadata">
                            <option value="">Not set</option>
                            <option>Low</option>
                            <option>Normal</option>
                            <option>High</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label" for="advanced-region">Region</label>
                        <input class="form-control" id="advanced-region" @bind="region" @bind:event="oninput" @bind:after="RevalidateMetadata" />
                    </div>
                }
            </div>
            @for (var i = 0; i < propertyRows.Count; i++)
            {
                var row = propertyRows[i];
                var number = i + 1;
                var keyId = $"property-key-{row.Id}";
                var valueId = $"property-value-{row.Id}";
                <div class="metadata-fields align-items-end mb-2" @key="row">
                    <div>
                        <label class="form-label" for="@keyId">Property @number key</label>
                        <input class="form-control" id="@keyId" @ref="row.KeyInput" @bind="row.Key" @bind:event="oninput" @bind:after="RevalidateMetadata" />
                    </div>
                    <div>
                        <label class="form-label" for="@valueId">Property @number value</label>
                        <input class="form-control" id="@valueId" @bind="row.Value" @bind:event="oninput" @bind:after="RevalidateMetadata" />
                    </div>
                    <button type="button" class="btn btn-outline-secondary" aria-label="Remove property @number" @onclick="() => RemoveProperty(row)">Remove</button>
                </div>
            }
            <button type="button" id="add-property" class="btn btn-outline-secondary" @onclick="AddProperty" @ref="addPropertyButton">Add property</button>
        </fieldset>
    </details>

    <button type="submit" class="btn btn-primary" disabled="@Busy">
        @if (isSending)
        {
            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
            <span>Sending...</span>
        }
        else
        {
            <span>Send</span>
        }
    </button>
</EditForm>

<form id="burst-form" @formname="send-burst" @onsubmit="SendBurstAsync" @onsubmit:preventDefault>
    <fieldset class="burst-controls mt-3">
        <legend class="h5">Burst sender</legend>
        @if (IsTopicFilters)
        {
            <p id="burst-unavailable" class="text-body-secondary">Burst sending is unavailable for Topic filters. Send one message at a time.</p>
        }
        <fieldset class="burst-inputs" disabled="@(Busy || IsTopicFilters)" aria-label="Burst settings">
            <div>
                <label for="burst-count" class="form-label">Count (1–500)</label>
                <input id="burst-count" class="form-control" inputmode="numeric" @bind="burstCount" @bind:event="oninput"
                       aria-invalid="@(countError is not null ? "true" : "false")" aria-describedby="burst-count-error" />
                <div id="burst-count-error" class="validation-message" aria-live="polite">@countError</div>
            </div>
            <div>
                <div class="form-check">
                    <input id="burst-paced" type="checkbox" class="form-check-input" @bind="fixedRate" />
                    <label for="burst-paced" class="form-check-label">Limit rate (unchecked: as fast as possible)</label>
                </div>
                @if (fixedRate)
                {
                    <label for="burst-rate" class="form-label">Rate (1–1000 messages per second)</label>
                    <input id="burst-rate" class="form-control" inputmode="numeric" @bind="burstRate" @bind:event="oninput"
                           aria-invalid="@(rateError is not null ? "true" : "false")" aria-describedby="burst-rate-error" />
                    <div id="burst-rate-error" class="validation-message" aria-live="polite">@rateError</div>
                }
            </div>
        </fieldset>
        @* Keep this node mounted and focusable through cancellation and completion. *@
        <button id="@(burstDelay is null ? "send-burst" : "cancel-burst")" type="@(burstDelay is null ? "submit" : "button")"
                class="btn @(burstDelay is null ? "btn-primary" : "btn-outline-secondary")" disabled="@(isSending || (IsTopicFilters && burstDelay is null))"
                aria-describedby="@(IsTopicFilters ? "burst-unavailable" : null)"
                aria-disabled="@(cancelPending ? "true" : null)" @onclick="CancelBurst" @ref="burstAction">
            @(burstDelay is null ? "Send burst" : "Cancel burst")
        </button>
        <div id="burst-navigation-warning" class="text-warning-emphasis @(burstDelay is not null ? "mt-2" : null)"
             role="status" aria-live="polite" aria-atomic="true">@(burstDelay is not null ? BurstNavigationWarning : null)</div>
    </fieldset>
</form>

@if (statusMessage is not null)
{
    <div class="alert @(isError ? "alert-danger" : "alert-success") mt-3" role="status">
        @statusMessage
    </div>
}

<div id="burst-counts-status" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true">@burstAnnouncement</div>
@if (burst is { } currentBurst)
{
    var stats = currentBurst.Snapshot();
    QueueAnnouncements(stats.Sent, stats.ConsumerOne, stats.ConsumerTwo);
    var expected = stats.Sent * (currentBurst.Pattern == MessagingPattern.PubSub ? consumers.Length : 1);
    <div class="burst-results mt-3" role="region" aria-labelledby="burst-heading">
        <h2 id="burst-heading" class="h5">Latest burst: @PatternLabel(currentBurst.Pattern.ToString())</h2>
        <p id="burst-status" class="@(burstFailed ? "text-danger-emphasis" : null)" role="status">@burstStatus</p>
        <label for="burst-progress">Acknowledged sends: @stats.Sent / @currentBurst.Requested</label>
        <progress id="burst-progress" class="burst-bar" max="@currentBurst.Requested" value="@stats.Sent"></progress>
        <p id="burst-total">Reported deliveries: @(stats.ConsumerOne + stats.ConsumerTwo) / @expected expected</p>
        @foreach (var consumer in consumers)
        {
            var count = consumer.Id == BurstDeliveryTracker.ConsumerOneId ? stats.ConsumerOne : stats.ConsumerTwo;
            var barId = $"burst-{consumer.Id}";
            <label for="@barId">@consumer.Label: @count</label>
            <progress id="@barId" class="burst-bar" max="@Math.Max(1, Math.Max(stats.Sent, count))" value="@count"></progress>
        }
        @if (stats.Overflowed)
        {
            <p class="text-warning-emphasis" role="status">The early-report buffer filled up; some burst reports may be missing.</p>
        }
        <p class="text-body-secondary mb-0">Reports are best-effort and may be lost. These counts do not measure broker backlog.
            Repeat reports from the same consumer are counted once per message, but redelivery to another competing consumer can put the total above expected.</p>
    </div>
}

<section class="mt-4" aria-labelledby="depth-heading" aria-describedby="depth-note">
    <h2 id="depth-heading" class="h5">Subscription depth</h2>
    <div id="depth-status" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true">@depthAnnouncement</div>
    <ul class="list-group mb-2">
        @for (var index = 0; index < depthSubscriptions.Length; index++)
        {
            var (topic, subscription) = depthSubscriptions[index];
            var count = pendingEstimates[index] = EstimatePending(topic, subscription, snapshot);
            <li class="list-group-item depth-row">
                <div><strong>Topic:</strong> <code>@topic</code> <strong>Subscription:</strong> <code>@subscription</code></div>
                <span class="depth-pending">Estimated pending: @count</span>
                <span class="d-block">Dead-letter count: unavailable</span>
            </li>
        }
    </ul>
    <p id="depth-note" class="text-body-secondary">
        Subscription depth is unavailable for Topic filters (<code>routed-events</code>).
        Estimates above cover acknowledged sends in this page session only, not external sends. A report reduces the estimate
        even if the attempt was abandoned and can be retried. Reports are best-effort, and only the latest 200 are retained.
        Clearing the feed or reports aging out of it can increase the estimate. Reloading loses this page’s sent history.

    </p>
</section>

<section class="deliveries mt-4" aria-labelledby="deliveries-heading" aria-describedby="delivery-report-help">
    <div class="d-flex align-items-center justify-content-between mb-2">
        <h2 id="deliveries-heading" class="h5 mb-0">Deliveries</h2>
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Feed.Clear">Clear</button>
    </div>
    <p id="delivery-report-help" class="text-body-secondary">Cards appear only after an attempt is settled, so a slow attempt won't appear while its delay is still running.
        Reports can be lost; a missing card doesn't mean settlement failed.</p>
    <p class="text-body-secondary">Only recent reports are shown, across all tabs. Clear removes shared reports, not sent history or burst statistics.</p>
    <p class="text-body-secondary">Automatic lock renewal can extend a message's lock past the initial expiration shown on its card.
        A long handler delay does not guarantee lock expiry.</p>
    <div id="delivery-status" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true">
        <span @key="deliveryStatusVersion">@deliveryStatus</span>
    </div>
    <div class="delivery-lanes">
        @foreach (var consumer in consumers)
        {
            var cards = deliveriesByConsumer[consumer.Id];
            var lane = LaneFor(consumer.Id);
            <section id="@consumer.Id" aria-labelledby="@(consumer.Id + "-heading")">
                <h3 id="@(consumer.Id + "-heading")" class="h6">@consumer.Label</h3>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="badge text-bg-secondary consumer-status" role="status" aria-atomic="true">
                        <span class="visually-hidden">@consumer.Label status: </span><span class="consumer-state">@lane.Badge</span>
                    </span>
                    <button type="button" class="btn btn-outline-secondary btn-sm consumer-pause" aria-label="Pause @consumer.Label"
                            aria-disabled="@(lane.ActionDisabled(true) ? "true" : null)" @onclick="() => ChangeConsumerAsync(consumer.Id, true)">Pause</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm consumer-resume" aria-label="Resume @consumer.Label"
                            aria-disabled="@(lane.ActionDisabled(false) ? "true" : null)" @onclick="() => ChangeConsumerAsync(consumer.Id, false)">Resume</button>
                </div>
                <div class="text-danger-emphasis consumer-error" role="status" aria-atomic="true">
                    @if (lane.Error is { } error)
                    {
                        @($"{consumer.Label}: {error}")
                    }
                </div>
                @if (!cards.Any())
                {
                    <p class="text-body-secondary">No deliveries reported.</p>
                }
                @foreach (var card in cards.Reverse())
                {
                    var delivery = card.Delivery;
                    var matchCount = cardsByMessage[delivery.MessageId].Count() - 1;
                    var matchDescriptionId = $"delivery-matches-{card.Sequence}";
                    var isHighlighted = active is not null && delivery.MessageId == highlightedId;
                    var receivedAt = delivery.ReceivedAt.ToLocalTime();
                    var initialLock = delivery.InitialLockedUntil.ToLocalTime();
                    var settledAt = delivery.SettledAt.ToLocalTime();
                    var patternClass = delivery.Pattern switch
                    {
                        nameof(MessagingPattern.CompetingConsumers) => "pattern-competing",
                        nameof(MessagingPattern.PubSub) => "pattern-pubsub",
                        nameof(MessagingPattern.TopicFilters) => "pattern-topic-filters",
                        _ => ""
                    };
                    <article @key="card.Sequence" class="delivery-card @patternClass @(isHighlighted ? "delivery-highlighted" : "")"
                             tabindex="0" aria-label="Delivery to @consumer.Label" aria-describedby="@matchDescriptionId"
                             @onmouseenter="() => hoveredCard = new(card, ++interactionOrder)"
                             @onmouseleave="() => EndInteraction(ref hoveredCard, card)"
                             @onfocus="() => focusedCard = new(card, ++interactionOrder)"
                             @onblur="() => EndInteraction(ref focusedCard, card)">
                        <span id="@matchDescriptionId" class="visually-hidden">@MatchDescription(matchCount)</span>
                        <strong class="delivery-pattern">@PatternLabel(delivery.Pattern)</strong>
                        <dl class="mb-0 mt-2">
                            <dt>Subscription</dt>
                            <dd><code>@delivery.Subscription</code></dd>
                            <dt>Message ID</dt>
                            <dd><code>@delivery.MessageId</code></dd>
                            <dt>Body</dt>
                            <dd class="delivery-body">@delivery.Body</dd>
                            <dt>Received (local time)</dt>
                            <dd><time datetime="@receivedAt.ToString("O")">@LocalTimeLabel(receivedAt)</time></dd>
                            <dt>Delivery count</dt>
                            <dd>@delivery.DeliveryCount</dd>
                            <dt>Outcome</dt>
                            <dd>@delivery.Outcome</dd>
                            <dt>Initial lock expiration (local time)</dt>
                            <dd><time datetime="@initialLock.ToString("O")">@LocalTimeLabel(initialLock)</time></dd>
                            <dt>Settled (local time)</dt>
                            <dd><time datetime="@settledAt.ToString("O")">@LocalTimeLabel(settledAt)</time></dd>
                            <dt>Elapsed handling time</dt>
                            <dd class="mb-0">@((delivery.SettledAt - delivery.ReceivedAt).TotalSeconds.ToString("0.000")) s</dd>
                        </dl>
                        <MessageMetadata Subject="@delivery.Subject" CorrelationId="@delivery.CorrelationId" ApplicationProperties="delivery.ApplicationProperties" />
                    </article>
                }
            </section>
        }
    </div>
</section>

@if (sentMessages.Count > 0)
{
    var hasRoutedMessages = sentMessages.Any(sent => sent.Pattern == MessagingPattern.TopicFilters);
    <h2 id="sent-heading" class="h5 mt-4">Sent this session</h2>
    <p id="sent-consumers-note" class="text-body-secondary">Only retained delivery reports are shown. A missing report does not prove non-delivery.</p>
    <div class="table-responsive" role="region" tabindex="0" aria-labelledby="sent-heading" aria-describedby="sent-consumers-note">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Sent</th>
                    <th>Pattern</th>
                    <th>Topic</th>
                    <th>Message ID</th>
                    <th>Message</th>
                    <th>Metadata</th>
                    <th>Consumers</th>
                    @if (hasRoutedMessages)
                    {
                        <th>Submitted routing properties</th>
                        <th>Reported subscriptions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var sent in sentMessages)
                {
                    var reportedCards = cardsByMessage[sent.MessageId];
                    var recipientLabels = string.Join(", ", consumers.Where(consumer => reportedCards.Any(card => card.Delivery.Consumer == consumer.Id))
                        .Select(consumer => consumer.Label));
                    <tr>
                        <td>@sent.SentAt.ToLocalTime().ToString("T")</td>
                        <td>@(sent.Pattern == MessagingPattern.PubSub ? "Pub/sub" : PatternLabel(sent.Pattern.ToString()))</td>
                        <td><code>@sent.Topic</code></td>
                        <td><code>@sent.MessageId</code></td>
                        <td>@sent.Request.Message</td>
                        <td class="sent-metadata">
                            <MessageMetadata Subject="@sent.Request.Subject" CorrelationId="@sent.Request.CorrelationId" ApplicationProperties="sent.Request.ApplicationProperties" />
                        </td>
                        <td>@(recipientLabels.Length > 0 ? recipientLabels : "None reported")</td>
                        @if (hasRoutedMessages)
                        {
                            var routed = sent.Pattern == MessagingPattern.TopicFilters;
                            <td class="sent-routing-properties">
                                @if (routed)
                                {
                                    <dl class="mb-0">
                                        <dt>Priority</dt>
                                        <dd class="mb-0">
                                            @if (sent.Request.Priority is { } priority)
                                            {
                                                <code>"@priority"</code>
                                            }
                                            else
                                            {
                                                <span>Not set</span>
                                            }
                                        </dd>
                                        <dt>Region</dt>
                                        <dd class="mb-0">
                                            @if (sent.Request.Region is { } region)
                                            {
                                                <code>"@region"</code>
                                            }
                                            else
                                            {
                                                <span>Not set</span>
                                            }
                                        </dd>
                                    </dl>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            var subscriptions = routed
                                ? string.Join(", ", reportedCards
                                    .Where(card => card.Delivery.Pattern == nameof(MessagingPattern.TopicFilters) && card.Delivery.Topic == sent.Topic)
                                    .Select(card => card.Delivery.Subscription)
                                    .Distinct(StringComparer.Ordinal).Order(StringComparer.Ordinal))
                                : null;
                            <td class="reported-subscriptions">@(subscriptions switch
                                {
                                    null => "—",
                                    "" => "None reported",
                                    _ => subscriptions
                                })</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
</div>

@code {
    private static readonly (string Id, string Label)[] consumers =
        [(BurstDeliveryTracker.ConsumerOneId, "Consumer One"), (BurstDeliveryTracker.ConsumerTwoId, "Consumer Two")];

    private readonly MessageModel model = new();
    private EditContext messageContext = default!;
    private readonly List<SentMessage> sentMessages = [];
    private CardInteraction? hoveredCard;
    private CardInteraction? focusedCard;
    private long interactionOrder;
    private long? lastReportCount;
    private long lastClearCount;
    private long deliveryStatusVersion;
    private long pendingDeliveryReports;
    private string? deliveryStatus;
    private volatile bool disposed;
    private bool isSending;
    private bool isError;
    private string? statusMessage;
    private bool IsTopicFilters => model.Pattern == MessagingPattern.TopicFilters;

    protected override void OnInitialized()
    {
        messageContext = new EditContext(model);
        Feed.Changed += OnFeedChanged;
    }

    private void OnFeedChanged() => _ = RefreshDeliveriesAsync();

    private async Task RefreshDeliveriesAsync()
    {
        if (disposed)
        {
            return;
        }

        try
        {
            await InvokeAsync(() =>
            {
                if (!disposed)
                {
                    StateHasChanged();
                }
            });
        }
        catch (ObjectDisposedException)
        {
            // Renderer teardown can race with a feed notification.
        }
        catch (Exception ex)
        {
            if (!disposed)
            {
                Logger.LogError(ex, "Failed to refresh live deliveries");
            }
        }
    }

    public void Dispose()
    {
        disposed = true;
        CloseDeadLetters();
        Feed.Changed -= OnFeedChanged;
        burst?.Dispose();
        burstDelay?.Cancel();
        pageLifetime.Cancel();
        pageLifetime.Dispose();
    }

    private void UpdateDeliveryStatus(DeliveryCard[] visibleCards, long reportCount, long clearCount)
    {
        if (lastReportCount is long previousReportCount)
        {
            var newReports = visibleCards.Count(card => card.Sequence > previousReportCount);
            var cleared = clearCount != lastClearCount;
            if (cleared)
            {
                pendingDeliveryReports = 0;
            }

            if (burst is null)
            {
                AnnounceDeliveryStatus(newReports, cleared);
            }
            else
            {
                // The shared cards include other tabs' reports, which the burst summary cannot represent.
                pendingDeliveryReports += newReports;
                AnnounceDeliveryStatus(0, cleared);
            }
        }

        lastReportCount = reportCount;
        lastClearCount = clearCount;
    }

    private void AnnounceDeliveryStatus(long newReports, bool cleared = false)
    {
        if (cleared || newReports > 0)
        {
            var arrival = newReports switch
            {
                0 => "",
                1 => "1 new delivery report.",
                _ => $"{newReports} new delivery reports."
            };
            deliveryStatus = cleared ? $"Delivery reports cleared. {arrival}".TrimEnd() : arrival;
            // Replace the child even for identical consecutive announcements, keeping the live region mounted.
            deliveryStatusVersion++;
        }
    }

    private static void EndInteraction(ref CardInteraction? interaction, DeliveryCard card)
    {
        if (interaction?.Card.Sequence == card.Sequence)
        {
            interaction = null;
        }
    }

    private static string MatchDescription(int matches) => matches switch
    {
        0 => "No other visible reports for this message.",
        1 => "1 other visible report for this message.",
        _ => $"{matches} other visible reports for this message."
    };

    private static string PatternLabel(string pattern) => pattern switch
    {
        nameof(MessagingPattern.CompetingConsumers) => "Competing consumers",
        nameof(MessagingPattern.PubSub) => "Publish/subscribe",
        nameof(MessagingPattern.TopicFilters) => "Topic filters",
        _ => pattern
    };

    private async Task SendAsync()
    {
        if (disposed || Busy)
        {
            return;
        }

        statusMessage = null;
        var request = CreateCompleteSendRequest(model.Message!.Trim());
        if (request is null)
        {
            if (metadataErrors.Count > 0)
            {
                FocusMetadataErrors();
            }
            else
            {
                FocusInvalidFailureOption();
            }
            return;
        }

        isSending = true;
        try
        {
            var pattern = model.Pattern;
            var result = await ProducerApi.SendMessageAsync(request, pattern, pageLifetime.Token);
            if (disposed)
            {
                return;
            }

            sentMessages.Insert(0, new SentMessage(result.MessageId, pattern, result.Topic, request, DateTimeOffset.UtcNow));
            statusMessage = $"Message {result.MessageId} published to '{result.Topic}'.";
            isError = false;
        }
        catch (Exception ex)
        {
            if (!disposed)
            {
                Logger.LogError(ex, "Failed to send message via producer API");
                statusMessage = $"Failed to send message: {ex.Message}";
                isError = true;
            }
        }
        finally
        {
            isSending = false;
        }
    }

    private sealed class MessageModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please enter a message.")]
        [System.ComponentModel.DataAnnotations.StringLength(4096)]
        public string? Message { get; set; }

        public string? Priority { get; set; }
        public string? Region { get; set; }
        public MessagingPattern Pattern { get; set; } = MessagingPattern.CompetingConsumers;
    }

    private sealed record DeliveryCard(long Sequence, DeliveryEvent Delivery);
    private sealed record CardInteraction(DeliveryCard Card, long Order);
    private sealed record SentMessage(string MessageId, MessagingPattern Pattern, string Topic, SendMessageRequest Request, DateTimeOffset SentAt);
}
